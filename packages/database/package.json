{
  "name": "@bingo/database",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "dotenv -c -e ../../.env -- prisma validate",
    "migrate:dev": "dotenv -c -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -c -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -c -e ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src prisma --no-warn-ignored",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
