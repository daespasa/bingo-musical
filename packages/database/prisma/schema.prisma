generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum RoomMode {
  PROJECTOR
  REMOTE
  HYBRID
}

enum RoomStatus {
  DRAFT
  LOBBY
  COUNTDOWN
  PLAYING
  PAUSED
  ROUND_RESULTS
  FINISHED
  CANCELLED
  EXPIRED
}

enum RoundStatus {
  WAITING
  PREPARING_AUDIO
  WAITING_FOR_CLIENTS
  SCHEDULED
  PLAYING
  ANSWER_WINDOW
  REVEALING
  SCORING
  ROUND_RESULTS
  SKIPPED
  FINISHED
}

enum GameStatus {
  DRAFT
  READY
  ARCHIVED
}

/// Modo de juego de una partida. Solo entran valores que el servidor sabe
/// jugar de principio a fin: un valor aquí es una promesa al anfitrión.
enum GameMode {
  MUSIC_BINGO
  MULTIPLE_CHOICE
  FREE_TEXT
  SURVIVAL
  MIXED
}

enum ParticipantRole {
  HOST
  PLAYER
  SCREEN
}

enum CellStatus {
  UNMARKED
  PENDING
  VALID
  INVALID
}

enum AudioReadinessStatus {
  NOT_ENABLED
  TESTING
  READY
  PRELOADING
  ERROR
}

enum TrackSource {
  DEMO
  SPOTIFY
}

enum ExternalProvider {
  SPOTIFY
}

enum PreviewProviderKind {
  DEMO_LOCAL
  SPOTIFY_PREVIEW_FINDER
}

enum PreviewStatus {
  AVAILABLE
  NOT_FOUND
  RATE_LIMITED
  INVALID_RESPONSE
  UNREACHABLE
  ERROR
}

enum ClaimType {
  LINE
  BINGO
}

enum ClaimStatus {
  ACCEPTED
  REJECTED
}

enum ScoreEventType {
  CORRECT_MARK
  SPEED_BONUS
  STREAK_BONUS
  LINE_BONUS
  BINGO_BONUS
  WRONG_MARK
  WRONG_CLAIM
  // Modos de pregunta: el acierto y el fallo no son marcas de cartón
  CORRECT_ANSWER
  WRONG_ANSWER
}

enum HighlightType {
  FASTEST_ANSWER
  LEADER_CHANGE
  BEST_STREAK
  FIRST_LINE
  BINGO
  BIGGEST_COMEBACK
  // Modos de pregunta
  ONLY_CORRECT
  ALL_CORRECT
  NOBODY_CORRECT
  POPULAR_DISTRACTOR
  // Supervivencia
  FIRST_ELIMINATION
  LAST_SURVIVOR
  MULTIPLE_ELIMINATION
  SURVIVED_ON_ONE_LIFE
}

/// Qué se pregunta sobre la canción que suena.
enum QuestionType {
  SONG_TITLE
  ARTIST
  RELEASE_YEAR
  DECADE
  ALBUM
}

enum AuditActorType {
  USER
  GUEST
  SYSTEM
}

// ---------- Identity ----------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  // Nulo en cuentas creadas con Google: no tienen contraseña local
  passwordHash  String?
  displayName   String
  avatarUrl     String?
  googleId      String?   @unique
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  games        Game[]
  rooms        Room[]
  participants RoomParticipant[]
  collections  MusicCollection[]
}

model Session {
  id             String   @id @default(uuid())
  tokenHash      String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  userAgent      String?
  ipHash         String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Music ----------

model Artist {
  id             String  @id @default(uuid())
  name           String
  normalizedName String
  tracks         Track[]

  @@unique([normalizedName])
}

model Album {
  id       String  @id @default(uuid())
  title    String
  coverUrl String?
  tracks   Track[]
}

model Track {
  id              String      @id @default(uuid())
  title           String
  normalizedTitle String
  artistId        String
  artist          Artist      @relation(fields: [artistId], references: [id])
  albumId         String?
  album           Album?      @relation(fields: [albumId], references: [id])
  durationMs      Int?
  /// Año de publicación. Alimenta las preguntas de año y de década; nulo
  /// significa que esas preguntas no pueden usar esta pista.
  releaseYear     Int?
  source          TrackSource @default(DEMO)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  externalRefs     ExternalTrackReference[]
  previews         TrackPreview[]
  collectionTracks MusicCollectionTrack[]
  rounds           GameRound[]
  cells            BingoCardCell[]

  @@index([normalizedTitle])
  @@index([artistId])
}

model ExternalTrackReference {
  id         String           @id @default(uuid())
  trackId    String
  track      Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  provider   ExternalProvider
  externalId String
  url        String?
  createdAt  DateTime         @default(now())

  @@unique([provider, externalId])
  @@index([trackId])
}

model TrackPreview {
  id              String              @id @default(uuid())
  trackId         String
  track           Track               @relation(fields: [trackId], references: [id], onDelete: Cascade)
  provider        PreviewProviderKind
  status          PreviewStatus
  url             String?
  durationMs      Int?
  confidence      Float               @default(0)
  resolvedAt      DateTime            @default(now())
  lastValidatedAt DateTime?

  @@unique([trackId, provider])
  @@index([status])
}

model MusicCollection {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDemo      Boolean  @default(false)
  /// Clave del tema cuando la colección la construye la aplicación
  themeKey    String?  @unique
  /// Última vez que el tema se reconstruyó con éxito
  refreshedAt DateTime?
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tracks MusicCollectionTrack[]
  games  Game[]

  @@index([ownerId])
}

model MusicCollectionTrack {
  id           String          @id @default(uuid())
  collectionId String
  collection   MusicCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  trackId      String
  track        Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position     Int

  @@unique([collectionId, trackId])
  @@unique([collectionId, position])
}

// ---------- Games ----------

model Game {
  id           String          @id @default(uuid())
  name         String
  status       GameStatus      @default(DRAFT)
  /// Las partidas anteriores a Gramola son bingo: por eso el valor por defecto
  /// es MUSIC_BINGO y la migración no necesita reescribir ninguna fila.
  mode         GameMode        @default(MUSIC_BINGO)
  /// Configuración específica del modo, validada con Zod al escribir y al leer
  /// (ver packages/shared/src/game-config.ts). Nulo = valores por defecto del
  /// modo, que es lo que corresponde al historial anterior.
  modeConfig   Json?
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collectionId String
  collection   MusicCollection @relation(fields: [collectionId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  settings GameSettings?
  rooms    Room[]

  @@index([ownerId])
}

model GameSettings {
  id                String  @id @default(uuid())
  gameId            String  @unique
  game              Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cardSize          Int     @default(3)
  freeCenter        Boolean @default(false)
  snippetDurationMs Int     @default(15000)
  answerWindowMs    Int     @default(10000)
  autoReveal        Boolean @default(true)
  autoAdvance       Boolean @default(true)
  roundResultsMs    Int     @default(6000)
  lineEnabled       Boolean @default(true)
  bingoEnabled      Boolean @default(true)
  showLeaderboard   Boolean @default(true)
  shuffleTracks     Boolean @default(true)
  correctMarkPoints Int     @default(100)
  speedBonusMax     Int     @default(50)
  streakBonusPoints Int     @default(50)
  linePoints        Int     @default(500)
  bingoPoints       Int     @default(1500)
  wrongMarkPenalty  Int     @default(-50)
  wrongClaimPenalty Int     @default(-100)
}

// ---------- Rooms ----------

model Room {
  id                   String     @id @default(uuid())
  code                 String     @unique
  gameId               String
  game                 Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  hostId               String
  host                 User       @relation(fields: [hostId], references: [id])
  mode                 RoomMode   @default(REMOTE)
  status               RoomStatus @default(LOBBY)
  cardAlgorithmVersion Int        @default(1)
  lockedAt             DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  expiresAt            DateTime
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  participants RoomParticipant[]
  rounds       GameRound[]
  cards        BingoCard[]
  claims       Claim[]
  scoreEvents  ScoreEvent[]
  snapshots    LeaderboardSnapshot[]
  highlights   Highlight[]
  result       GameResult?
  auditLogs    AuditLog[]
  lifeStates   PlayerLifeState[]

  @@index([status])
  @@index([expiresAt])
}

model RoomParticipant {
  id              String          @id @default(uuid())
  roomId          String
  room            Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  role            ParticipantRole @default(PLAYER)
  alias           String
  aliasNormalized String
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  joinedAt        DateTime        @default(now())
  leftAt          DateTime?
  kickedAt        DateTime?

  playerSessions PlayerSession[]
  devices        PlayerDevice[]
  audioReadiness AudioReadiness?
  card           BingoCard?
  marks          PlayerMark[]
  answers        PlayerAnswer[]
  claims         Claim[]
  scoreEvents    ScoreEvent[]
  highlights     Highlight[]
  wonResults     GameResult[]
  lifeState      PlayerLifeState?

  @@unique([roomId, aliasNormalized])
  @@index([roomId])
}

model PlayerSession {
  id            String          @id @default(uuid())
  participantId String
  participant   RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  tokenHash     String          @unique
  expiresAt     DateTime
  createdAt     DateTime        @default(now())

  @@index([participantId])
}

model PlayerDevice {
  id            String          @id @default(uuid())
  participantId String
  participant   RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  userAgent     String?
  lastSeenAt    DateTime        @default(now())

  @@index([participantId])
}

model AudioReadiness {
  id            String               @id @default(uuid())
  participantId String               @unique
  participant   RoomParticipant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  status        AudioReadinessStatus @default(NOT_ENABLED)
  errorMessage  String?
  updatedAt     DateTime             @updatedAt
}

// ---------- Cards ----------

model BingoCard {
  id               String          @id @default(uuid())
  roomId           String
  room             Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId    String          @unique
  participant      RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  size             Int
  seed             String
  algorithmVersion Int             @default(1)
  createdAt        DateTime        @default(now())

  cells BingoCardCell[]

  @@index([roomId])
}

model BingoCardCell {
  id            String     @id @default(uuid())
  cardId        String
  card          BingoCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position      Int
  trackId       String?
  track         Track?     @relation(fields: [trackId], references: [id])
  displayTitle  String
  displayArtist String
  isFree        Boolean    @default(false)
  status        CellStatus @default(UNMARKED)
  markedAt      DateTime?
  validatedAt   DateTime?

  marks PlayerMark[]

  @@unique([cardId, position])
  @@index([trackId])
}

// ---------- Rounds & scoring ----------

model GameRound {
  id         String      @id @default(uuid())
  roomId     String
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  index      Int
  trackId    String
  track      Track       @relation(fields: [trackId], references: [id])
  status     RoundStatus @default(WAITING)
  startsAt   DateTime?
  endsAt     DateTime?
  revealedAt DateTime?
  createdAt  DateTime    @default(now())

  marks    PlayerMark[]
  claims   Claim[]
  scores   ScoreEvent[]
  question RoundQuestion?
  answers  PlayerAnswer[]

  @@unique([roomId, index])
  @@index([roomId, status])
}

/// La pregunta de una ronda en los modos que preguntan.
///
/// Se persiste al crear la ronda para que todo el mundo reciba exactamente la
/// misma pregunta y las mismas opciones, y para que el resultado sea
/// reconstruible después sin volver a generarla.
model RoundQuestion {
  id      String       @id @default(uuid())
  roundId String       @unique
  round   GameRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  type    QuestionType
  /// Enunciado ya redactado, para no recomponerlo en cada superficie.
  prompt  String
  /// Respuesta correcta en texto, para el reveal y el historial. Nunca viaja
  /// al cliente antes de que la ronda se revele.
  correctText String

  options AnswerOption[]
  answers PlayerAnswer[]
}

/// Una opción de respuesta. `isCorrect` no sale nunca del servidor antes del
/// reveal: el cliente recibe las opciones sin esa columna.
model AnswerOption {
  id         String        @id @default(uuid())
  questionId String
  question   RoundQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  text       String
  isCorrect  Boolean       @default(false)

  answers PlayerAnswer[]

  @@unique([questionId, position])
  @@index([questionId])
}

/// Vidas de una persona en una partida de supervivencia.
///
/// Se persiste, y no solo en memoria, porque es lo que decide quién sigue
/// jugando: una reconexión no puede devolver vidas ni resucitar a nadie. Las
/// vidas **no** son puntos y no viajan por `ScoreEvent`.
model PlayerLifeState {
  id                String          @id @default(uuid())
  roomId            String
  room              Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId     String          @unique
  participant       RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  lives             Int
  /// Índice de la ronda en la que se quedó sin vidas. Nulo = sigue en juego.
  eliminatedAtRound Int?
  /// Orden de eliminación, para la ceremonia. Nulo mientras siga en juego.
  eliminationOrder  Int?
  updatedAt         DateTime        @updatedAt

  @@index([roomId])
}

/// La respuesta de una persona a una ronda.
model PlayerAnswer {
  id            String          @id @default(uuid())
  roundId       String
  round         GameRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  questionId    String
  question      RoundQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participantId String
  participant   RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  /// Opción elegida en preguntas con opciones.
  optionId      String?
  option        AnswerOption?   @relation(fields: [optionId], references: [id], onDelete: SetNull)
  /// Texto escrito en respuesta libre. Preparado para el modo de adivinar.
  freeText      String?
  isCorrect     Boolean
  latencyMs     Int?
  /// Número de intento, empezando en 1. Con un solo intento siempre vale 1.
  attempt       Int             @default(1)
  createdAt     DateTime        @default(now())

  /// Impide contar dos veces el mismo intento aunque el evento llegue repetido.
  @@unique([roundId, participantId, attempt])
  @@index([participantId])
}

model PlayerMark {
  id            String          @id @default(uuid())
  roundId       String
  round         GameRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId String
  participant   RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  cellId        String
  cell          BingoCardCell   @relation(fields: [cellId], references: [id], onDelete: Cascade)
  isCorrect     Boolean
  latencyMs     Int?
  markedAt      DateTime        @default(now())

  @@unique([roundId, cellId])
  @@index([participantId])
}

model Claim {
  id             String          @id @default(uuid())
  roomId         String
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId  String
  participant    RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  roundId        String?
  round          GameRound?      @relation(fields: [roundId], references: [id], onDelete: SetNull)
  type           ClaimType
  status         ClaimStatus
  detail         String?
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())

  @@index([roomId, type, status])
}

model ScoreEvent {
  id             String          @id @default(uuid())
  roomId         String
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId  String
  participant    RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  roundId        String?
  round          GameRound?      @relation(fields: [roundId], references: [id], onDelete: SetNull)
  type           ScoreEventType
  points         Int
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())

  @@index([roomId, participantId])
}

model LeaderboardSnapshot {
  id         String   @id @default(uuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundIndex Int
  // Snapshot inmutable del ranking al cierre de la ronda; JSON justificado
  entries    Json
  createdAt  DateTime @default(now())

  @@unique([roomId, roundIndex])
}

model Highlight {
  id            String           @id @default(uuid())
  roomId        String
  room          Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String?
  participant   RoomParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  type          HighlightType
  roundIndex    Int?
  // Datos específicos del highlight (latencia, racha...); JSON justificado
  data          Json?
  createdAt     DateTime         @default(now())

  @@index([roomId])
}

model GameResult {
  id                  String           @id @default(uuid())
  roomId              String           @unique
  room                Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winnerParticipantId String?
  winner              RoomParticipant? @relation(fields: [winnerParticipantId], references: [id], onDelete: SetNull)
  totalRounds         Int
  durationMs          Int
  // Resumen final: ranking, líneas, bingos; snapshot inmutable, JSON justificado
  summary             Json
  finishedAt          DateTime         @default(now())
}

model AuditLog {
  id        String         @id @default(uuid())
  actorType AuditActorType
  actorId   String?
  roomId    String?
  room      Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  action    String
  data      Json?
  createdAt DateTime       @default(now())

  @@index([roomId])
  @@index([createdAt])
}
